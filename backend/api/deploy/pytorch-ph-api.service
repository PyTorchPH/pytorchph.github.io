[Unit]
Description=PyTorch PH API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/pytorch-ph-api/current
EnvironmentFile=/etc/pytorch-ph-api.env
ExecStart=/opt/pytorch-ph-api/current/pytorch-ph-api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pytorch-ph-api

[Install]
WantedBy=multi-user.target
