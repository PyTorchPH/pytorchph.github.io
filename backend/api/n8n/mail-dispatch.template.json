{
  "name": "PyTorch PH approved mail dispatch - DISABLED TEMPLATE",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "nodes": [
    {
      "id": "schedule",
      "name": "Every five minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 5 }]
        }
      }
    },
    {
      "id": "claim",
      "name": "Claim approved mail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8787/internal/mail/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      }
    },
    {
      "id": "has-job",
      "name": "Has approved job?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [{ "id": "job-exists", "leftValue": "={{ $json.job !== null }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }]
        }
      }
    },
    {
      "id": "gmail",
      "name": "Send approved Gmail without PDF",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1100, 380],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.job.recipients.join(',') }}",
        "subject": "={{ $json.job.subject }}",
        "message": "={{ $json.job.body }}",
        "emailType": "text",
        "options": { "appendAttribution": false }
      }
    },
    {
      "id": "has-pdf",
      "name": "Has frozen PDF?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [{ "id": "pdf-exists", "leftValue": "={{ $json.job.hasPdf }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }]
        }
      }
    },
    {
      "id": "download-pdf",
      "name": "Download frozen PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 180],
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://127.0.0.1:8787/internal/mail/' + $('Claim approved mail').item.json.job.id + '/pdf' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "response": { "response": { "responseFormat": "file", "outputPropertyName": "data" } } }
      }
    },
    {
      "id": "gmail-pdf",
      "name": "Send approved Gmail with PDF",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1320, 180],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Claim approved mail').item.json.job.recipients.join(',') }}",
        "subject": "={{ $('Claim approved mail').item.json.job.subject }}",
        "message": "={{ $('Claim approved mail').item.json.job.body }}",
        "emailType": "text",
        "options": { "appendAttribution": false, "attachmentsUi": { "attachmentsBinary": [{ "property": "data" }] } }
      }
    },
    {
      "id": "receipt",
      "name": "Record sent receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://127.0.0.1:8787/internal/mail/' + $('Claim approved mail').item.json.job.id + '/receipt' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { status: 'sent', externalMessageId: $json.id } }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every five minutes": { "main": [[{ "node": "Claim approved mail", "type": "main", "index": 0 }]] },
    "Claim approved mail": { "main": [[{ "node": "Has approved job?", "type": "main", "index": 0 }]] },
    "Has approved job?": { "main": [[{ "node": "Has frozen PDF?", "type": "main", "index": 0 }], []] },
    "Has frozen PDF?": { "main": [[{ "node": "Download frozen PDF", "type": "main", "index": 0 }], [{ "node": "Send approved Gmail without PDF", "type": "main", "index": 0 }]] },
    "Download frozen PDF": { "main": [[{ "node": "Send approved Gmail with PDF", "type": "main", "index": 0 }]] },
    "Send approved Gmail with PDF": { "main": [[{ "node": "Record sent receipt", "type": "main", "index": 0 }]] },
    "Send approved Gmail without PDF": { "main": [[{ "node": "Record sent receipt", "type": "main", "index": 0 }]] }
  }
}
