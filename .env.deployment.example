# Local deployment metadata only. Never commit .env.deployment or credential values.
DEPLOY_SSH_HOST=api.pytorch.ph
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=
# Optional existing SSH alias; leave blank when using host + user.
DEPLOY_SSH_ALIAS=
# Optional existing key path; never paste a private key or password here.
DEPLOY_SSH_IDENTITY_FILE=
DEPLOY_API_ORIGIN=https://api.pytorch.ph
DEPLOY_SERVICE=pytorch-ph-api.service
DEPLOY_REMOTE_BINARY=/opt/pytorch-ph-api/current/pytorch-ph-api
DEPLOY_DATABASE=/var/lib/pytorch-ph-api/portal.db
