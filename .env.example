# LLM provider configuration (only required for AI mode)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Production model boundary: always call an HTTP API. The same OpenAI-compatible
# contract supports a cloud endpoint or a locally hosted model server.
# One of: openai-compatible | openai | anthropic | null
RESUME_LLM_PROVIDER=openai-compatible
RESUME_LLM_API_BASE_URL=https://api.openai.com/v1
RESUME_LLM_API_KEY=
RESUME_LLM_MODEL=gpt-4o-mini

# Default model per provider
RESUME_ANTHROPIC_MODEL=claude-sonnet-4-6
RESUME_OPENAI_MODEL=gpt-4o-mini

# GitHub user/org to scan (override via CLI --gh-user)
RESUME_GH_USER=
# Product default: scrape the normal GitHub website. "cli" is developer convenience only.
RESUME_GITHUB_SOURCE=website

# Override config directory (defaults to ./config)
RESUME_CONFIG_DIR=

# Web OAuth for Dashboard identity login.
# Create provider apps first, then paste the values here or set them in PowerShell.
CAREERLENS_BASE_URL=http://127.0.0.1:8010

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Local questionnaire document store (MongoDB Community through rootless Podman)
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DATABASE=pytorch_ph
# Private runtime contact value for unattended Indeed form filling.
# Keep the real value in ~/.config/pytorch-ph/indeed-private.env (mode 0600), not in Git/MongoDB.
PYTORCH_PH_VERIFIED_PHONE=

# Optional repository-local runtime roots. Defaults: ./var and ./out.
PYTORCH_PH_VAR_ROOT=
PYTORCH_PH_ARTIFACT_ROOT=

# PH portal build settings (static export on GitHub Pages -> Rust API).
# Never copy FIT credentials.
NEXT_PUBLIC_API_ORIGIN=https://api.pytorch.ph
NEXT_PUBLIC_AUTH_API_ORIGIN=https://api.pytorch.ph
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
PYTORCH_PH_MEMBER_HOSTS=members.example.org
PYTORCH_PH_OFFICER_HOSTS=officers.example.org
PYTORCH_PH_MEMBER_URL=https://members.example.org
PYTORCH_PH_OFFICER_URL=https://officers.example.org

# Equal-authority presidential seats: required distinct approvals, default 2; allowed 1 or 2.
PRESIDENT_REQUIRED_APPROVALS=2

# Public footer build defaults; blank means omit. Never put private mail credentials here.
PUBLIC_SITE_FACEBOOK_URL=
PUBLIC_SITE_LINKEDIN_URL=
PUBLIC_SITE_CONTACT_EMAIL=

# Local officer CLI/MCP; settings must be supplied to that local process.
PORTAL_API_ORIGIN=https://api.pytorch.ph
PORTAL_SITE_ORIGIN=https://pytorch.ph
PORTAL_ENABLE_WRITES=0
AI_PSEUDONYM_KEY_HEX=
AI_PSEUDONYM_KEY_VERSION=k1
# Backend-only independent random 32-byte key (64 hex chars). Never expose as NEXT_PUBLIC_*.
# Credentials are stored locally after CLI login; never commit a session cookie.
